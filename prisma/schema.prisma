// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum ParticipantStatus {
  PENDING
  APPROVED
}

enum NotificationType {
  DRAW_RESULT
  GROUP_INVITE
  PARTICIPANT_JOINED
  WISHLIST_UPDATED
}

enum UserRole {
  USER
  ADMIN
}

model User {
  id            Int            @id @default(autoincrement())
  firebaseUid   String?        @unique
  name          String
  email         String         @unique
  password      String?
  phone         String?
  role          UserRole       @default(USER)
  refreshToken  String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  ownedGroups   Group[]        @relation("GroupOwner")
  participants  Participant[]
  notifications Notification[]
  activityLogs  ActivityLog[]

  @@map("users")
}

model Group {
  id             Int            @id @default(autoincrement())
  name           String
  description    String?
  drawDate       DateTime
  minValue       Float?
  maxValue       Float?
  inviteCode     String         @unique
  ownerId        Int
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  owner          User           @relation("GroupOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  participants   Participant[]
  drawResults    DrawResult[]
  notifications  Notification[]

  @@map("groups")
}

model Participant {
  id              Int               @id @default(autoincrement())
  userId          Int
  groupId         Int
  status          ParticipantStatus @default(PENDING)
  joinedAt        DateTime          @default(now())
  approvedAt      DateTime?
  user            User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  group           Group             @relation(fields: [groupId], references: [id], onDelete: Cascade)
  wishlist        Wishlist?
  giverIn         Pair[]            @relation("Giver")
  takerIn         Pair[]            @relation("Taker")
  blockedAsGiver  Restriction[]     @relation("BlockedGiver")
  blockedAsTaker  Restriction[]     @relation("BlockedTaker")

  @@unique([userId, groupId])
  @@map("participants")
}

model Wishlist {
  id            Int         @id @default(autoincrement())
  participantId Int         @unique
  items         Json
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  participant   Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)

  @@map("wishlists")
}

model Restriction {
  id              Int         @id @default(autoincrement())
  blockedGiverId  Int
  blockedTakerId  Int
  createdAt       DateTime    @default(now())
  blockedGiver    Participant @relation("BlockedGiver", fields: [blockedGiverId], references: [id], onDelete: Cascade)
  blockedTaker    Participant @relation("BlockedTaker", fields: [blockedTakerId], references: [id], onDelete: Cascade)

  @@unique([blockedGiverId, blockedTakerId])
  @@map("restrictions")
}

model DrawResult {
  id          Int      @id @default(autoincrement())
  groupId     Int      @unique
  performedAt DateTime @default(now())
  group       Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  pairs       Pair[]

  @@map("draw_results")
}

model Pair {
  id           Int         @id @default(autoincrement())
  drawResultId Int
  giverId      Int
  takerId      Int
  drawResult   DrawResult  @relation(fields: [drawResultId], references: [id], onDelete: Cascade)
  giver        Participant @relation("Giver", fields: [giverId], references: [id], onDelete: Cascade)
  taker        Participant @relation("Taker", fields: [takerId], references: [id], onDelete: Cascade)

  @@unique([drawResultId, giverId])
  @@map("pairs")
}

model Notification {
  id        Int              @id @default(autoincrement())
  userId    Int
  groupId   Int?
  type      NotificationType
  message   String
  read      Boolean          @default(false)
  createdAt DateTime         @default(now())
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  group     Group?           @relation(fields: [groupId], references: [id], onDelete: SetNull)

  @@map("notifications")
}

model ActivityLog {
  id        Int      @id @default(autoincrement())
  type      String
  message   String
  userId    Int?
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@map("activity_logs")
}
